public RotarySwitchSubsystem() \{\par
        dtPin = new DigitalInput(RotarySwitch.DT_CHANNEL);\par
        clkPin = new DigitalInput(RotarySwitch.CLK_CHANNEL);\par
        swPin = new DigitalInput(RotarySwitch.SW_CHANNEL);\par
        lastClockState = clkPin.get() ? 1 : 0;\par
        totalTurns = 0;\par
    \}\par
\par
    @Override\par
    public void periodic() \{\par
        int clkState = clkPin.get() ? 1 : 0;\par
        int dtState = dtPin.get() ? 1 : 0;\par
\par
        if (clkState != lastClockState) \{\par
            if (dtState != clkState) \{\par
                totalTurns++;\par
            \} else \{\par
                totalTurns--;\par
            \}\par
            lastClockState = clkState;\par
        \}\par
\par
        SmartDashboard.putNumber("RotarySwitch", totalTurns);\par
    \}\par
\par
    public int getTotalTurns() \{\par
        return totalTurns;\par
    \}\par
\par
    public boolean isSwitchPressed() \{\par
        return !swPin.get();\par
    \}\par
\}\par
