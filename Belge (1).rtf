  public void manualControl(double speed) \{\par
        leaderMotor.set(speed);\par
\par
        double maxRPM = 6000;\par
        double loopTimeSeconds = 0.02;\par
\par
        double revolutionsPerSecond = (maxRPM / 60.0) * Math.abs(speed);\par
        double revolutionsPerLoop = revolutionsPerSecond * loopTimeSeconds;\par
\par
        simEncoder += speed > 0 ? revolutionsPerLoop : -revolutionsPerLoop;\par
    \}\par
\par
    // OCALPID\par
    public void MoveIT(double speed, double setpoint) \{\par
        if (EnabledParts.IS_INTAKE_MOVER_ENABLED) \{\par
            if (OI.IS_INTAKE_MOVING) \{\par
                double leaderPosition = getLeaderMotorEncoder();\par
                if (isWithinTolerance(leaderPosition, setpoint)) \{\par
                    stopMotors();\par
                    OI.IS_INTAKE_MOVING = false;\par
                \} else \{\par
                    double maxRPM = 6000;\par
                    double loopTimeSeconds = 0.02;\par
                    double revolutionsPerSecond = (maxRPM / 60.0) * Math.abs(speed);\par
                    double revolutionsPerLoop = revolutionsPerSecond * loopTimeSeconds;\par
\par
                    if (leaderPosition > setpoint) \{\par
                        leaderMotor.set(-speed);\par
                        simEncoder -= revolutionsPerLoop;\par
                    \} else \{\par
                        leaderMotor.set(speed);\par
                        simEncoder += revolutionsPerLoop;\par
                    \}\par
                \}\par
            \}\par
        \} else \{\par
            OI.IS_INTAKE_MOVING = false;\par
        \}\par
    \}\par
\par
    private boolean isWithinTolerance(double value, double target) \{\par
        return value >= target - IntakeMover.OCAL_PID_TOLERANCE_VALUE\par
                && value <= target + IntakeMover.OCAL_PID_TOLERANCE_VALUE;\par
    \}\par
\par
    private void stopMotors() \{\par
        leaderMotor.stopMotor();\par
    \}\par
